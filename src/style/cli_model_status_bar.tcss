#cli-model-bar-container {
    width: 100%;
    height: 1;
    align: left middle; 
}

#model-name-label {
    margin-right: 2;   
    height: 1;
    align: left middle;
}

#model-provider-label {
    margin-right: 2;
    height: 1;
    align: left middle;
}

#mode-auto-mode-label {
    height: 1;
    align: left middle;
}

#context-progress-box {
    width: 1fr;                  
    height: 1;
    align-horizontal: right;    
    align-vertical: middle;
}

#context-text-label {
    color: #565f89;
    margin-right: 1;
}

#context-progress-bar {
    width: 20;            
    height: 1;
    border: none;         
    padding: 0;
}

#context-progress-bar > Bar {
    color: #e0af68;       
    background: #24283b;  
}