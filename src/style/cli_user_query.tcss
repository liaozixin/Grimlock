GUserQuery {
    width: 100%;
    height: auto;

    margin-top: 1;
    margin-left: 0;
    margin-right: 1;
}

#cli-query-container {
    width: 100%;
    height: auto;
    border-left: heavy #9ece6a;
    background: rgba(158, 206, 106, 0.15);
    padding: 0 1;
}

#cli-query-label {
    width: auto;
    height: 1;
    text-style: bold;
    margin-right: 1; 
}

#cli-query-text {
    width: 1fr;   
    height: auto; 
    color: #e2e8f0; 
}