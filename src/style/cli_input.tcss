/* ================GInput======================= */

#cli-input-container {
    width: 100%;
    height: 100%;
    align: left middle;
    border-top: solid #414868;
    border-bottom: solid #414868;
    transition: border 300ms;
    height: 3;
}

#cli-input-container:focus-within {
    border-top: solid #7AA2F7; 
    border-bottom: solid #7AA2F7;
}

#cli-prompt-label {
    margin-left: 1
}

#cli-command-input {
    border: none;
    background: transparent;
    width: 1fr;
    padding-left: 1;
    height: 1;
}

#cli-command-input:focus {
    border: none;
    outline: none;
}

/* ============================================ */